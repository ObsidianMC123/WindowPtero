# Mẫu cấu hình WindowPtero - copy thành .env rồi sửa.
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux / macOS)
# File .env thật chứa mật khẩu -> KHÔNG commit / không gửi cho ai.

WP_PORT=2008
WP_HOST=0.0.0.0

WP_ADMIN_USER=admin
WP_ADMIN_PASS=doi-mat-khau-nay-di

# =1 khi chạy sau HTTPS
WP_HTTPS=0

# Số tầng proxy tin cậy (nginx/Cloudflare = 1)
# WP_TRUST_PROXY=1

# Cách truy cập khi cài bằng script deploy (install.ps1 trên Windows, install.sh trên Linux)
# port = mở cổng | tunnel = chỉ link Cloudflare | both = cả hai
WP_ACCESS=both

# 2GB mỗi file
WP_MAX_UPLOAD_BYTES=2147483648
WP_MAX_UPLOAD_FILES=20
